{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user identity record for candidates, interviewers, and HR administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth unique identifier" },
        "email": { "type": "string", "format": "email", "description": "Primary verified email address" },
        "phone": { "type": "string", "description": "Contact telephone number" },
        "role": {
          "type": "string",
          "enum": ["candidate", "super_admin", "hr_admin", "recruitment_manager", "interview_coordinator", "interviewer"],
          "description": "Role-based access control privilege"
        },
        "displayName": { "type": "string", "description": "Full name of the user" },
        "avatarInitials": { "type": "string", "description": "Initials for avatar presentation" },
        "department": { "type": "string", "description": "Company organizational unit or department" },
        "isActive": { "type": "boolean", "description": "System account activation status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last profile update timestamp" }
      },
      "required": ["uid", "email", "role", "displayName", "isActive"]
    },
    "CandidateProfile": {
      "title": "CandidateProfile",
      "description": "Extended candidate academic background, professional skills, and resume metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Matches candidate User UID" },
        "candidateType": { "type": "string", "enum": ["fresher", "experienced"], "description": "Candidate experience track" },
        "fullName": { "type": "string", "description": "Legal candidate name" },
        "email": { "type": "string", "format": "email", "description": "Candidate email address" },
        "phone": { "type": "string", "description": "Candidate phone number" },
        "currentLocation": { "type": "string", "description": "Current city of residence" },
        "preferredLocations": { "type": "array", "description": "Preferred work locations" },
        "education": { "type": "object", "description": "Academic qualifications and scores" },
        "workExperience": { "type": "object", "description": "Prior professional experience" },
        "skills": { "type": "array", "description": "Declared and verified technical skill stack" },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "action_required"], "description": "HR document verification status" },
        "profileCompletionPercentage": { "type": "number", "description": "Profile readiness metric (0-100)" },
        "resumeStorageUrl": { "type": "string", "description": "Cloud Storage URI to private encrypted resume PDF" },
        "resumeOriginalName": { "type": "string", "description": "Original file name uploaded by candidate" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "candidateType", "currentLocation"]
    },
    "HiringDrive": {
      "title": "HiringDrive",
      "description": "Recruitment drive organized by Excelsoft Technologies with interview capacity limits.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique drive identifier" },
        "title": { "type": "string", "description": "Drive public campaign name" },
        "company": { "type": "string", "description": "Hiring corporate entity" },
        "role": { "type": "string", "description": "Target job role or designation" },
        "candidateType": { "type": "string", "enum": ["fresher", "experienced"] },
        "locations": { "type": "array", "description": "Drive venue cities" },
        "startDate": { "type": "string", "description": "Drive start date" },
        "endDate": { "type": "string", "description": "Drive end date" },
        "interviewCapacity": { "type": "number", "description": "Maximum interview slots available" },
        "currentRegistrations": { "type": "number", "description": "Current confirmed candidates count" },
        "mandatorySkills": { "type": "array", "description": "Required prerequisite technical skills" },
        "preferredSkills": { "type": "array", "description": "Bonus technical skills" },
        "minimumCgpa": { "type": "number", "description": "Cutoff CGPA threshold" },
        "requiredDegree": { "type": "array", "description": "Eligible academic degrees" },
        "description": { "type": "string", "description": "Drive overview and job scope" },
        "status": { "type": "string", "enum": ["active", "upcoming", "completed", "paused"] },
        "stages": { "type": "array", "description": "Hiring pipeline stages" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "company", "role", "interviewCapacity", "status"]
    },
    "Application": {
      "title": "Application",
      "description": "Candidate application to a specific hiring drive, tracking lifecycle status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Application identifier" },
        "candidateId": { "type": "string", "description": "Reference to candidate User UID" },
        "hiringDriveId": { "type": "string", "description": "Reference to HiringDrive document ID" },
        "hiringDriveTitle": { "type": "string", "description": "Denormalized drive title" },
        "role": { "type": "string", "description": "Target role designation" },
        "company": { "type": "string", "description": "Target hiring company" },
        "appliedLocation": { "type": "string", "description": "Selected venue location" },
        "appliedDate": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["registered", "shortlisted", "waitlisted", "standby", "confirmed", "under_review", "completed", "rejected", "blocked"]
        },
        "stages": { "type": "array", "description": "Current stage statuses" },
        "statusHistory": { "type": "array", "description": "Audit trail of status changes" },
        "interviewSlotId": { "type": "string", "description": "Assigned slot ID if confirmed" },
        "rejectionReason": { "type": "string", "description": "Reason notes if disqualified" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "candidateId", "hiringDriveId", "status"]
    },
    "InterviewSlot": {
      "title": "InterviewSlot",
      "description": "Allocated physical interview slot panel with concurrency mutex lock.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Slot identifier" },
        "hiringDriveId": { "type": "string", "description": "Associated drive" },
        "applicationId": { "type": "string", "description": "Booked application ID" },
        "candidateId": { "type": "string", "description": "Booked candidate UID" },
        "date": { "type": "string", "description": "Interview calendar date YYYY-MM-DD" },
        "time": { "type": "string", "description": "Time window string" },
        "reportingTime": { "type": "string", "description": "Venue check-in reporting time" },
        "location": { "type": "string", "description": "Interview campus city" },
        "roomOrPanel": { "type": "string", "description": "Panel identifier or room label" },
        "venueAddress": { "type": "string", "description": "Physical facility address" },
        "instructions": { "type": "array", "description": "Candidate arrival instructions" },
        "isLocked": { "type": "boolean", "description": "True when allocated or in transaction lock" },
        "lockedUntil": { "type": "string", "format": "date-time" },
        "isCheckInOpen": { "type": "boolean", "description": "True when venue coordinators enable QR checkin" },
        "attendanceVerified": { "type": "boolean", "description": "True once candidate check-in is ratified" },
        "checkedInAt": { "type": "string", "format": "date-time" },
        "qrTokenHash": { "type": "string", "description": "Cryptographic HMAC signature hash" },
        "otpCode": { "type": "string", "description": "Fallback 6-digit OTP passcode" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "hiringDriveId", "date", "time", "location", "roomOrPanel"]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Candidate queue position when drive capacity is temporarily exhausted.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Waitlist entry ID" },
        "hiringDriveId": { "type": "string" },
        "applicationId": { "type": "string" },
        "candidateId": { "type": "string" },
        "position": { "type": "number", "description": "Current numeric place in FIFO queue" },
        "totalInQueue": { "type": "number", "description": "Total waitlisted candidates" },
        "status": { "type": "string", "enum": ["active", "promoted_to_confirmed", "expired"] },
        "potentialBatchDate": { "type": "string", "description": "Target batch date" },
        "promotedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "hiringDriveId", "applicationId", "candidateId", "position", "status"]
    },
    "StandbyInvitation": {
      "title": "StandbyInvitation",
      "description": "Proactive standby pool invitation offering rapid slot claim upon no-shows.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Standby invitation ID" },
        "hiringDriveId": { "type": "string" },
        "applicationId": { "type": "string" },
        "candidateId": { "type": "string" },
        "location": { "type": "string" },
        "invitationStatus": {
          "type": "string",
          "enum": ["pending_response", "accepted", "declined", "replacement_offered", "confirmed_slot"]
        },
        "invitedAt": { "type": "string", "format": "date-time" },
        "responseDeadline": { "type": "string", "format": "date-time" },
        "respondedAt": { "type": "string", "format": "date-time" },
        "replacementSlot": { "type": "object", "description": "Assigned slot offer details" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "hiringDriveId", "applicationId", "candidateId", "invitationStatus"]
    },
    "AbsenceRecord": {
      "title": "AbsenceRecord",
      "description": "Audit record for missed interview slots requiring candidate justification and HR ratification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Absence record ID" },
        "applicationId": { "type": "string" },
        "hiringDriveId": { "type": "string" },
        "interviewSlotId": { "type": "string" },
        "candidateId": { "type": "string" },
        "candidateType": { "type": "string", "enum": ["fresher", "experienced"] },
        "missedDate": { "type": "string", "format": "date-time" },
        "deadlineForExplanation": { "type": "string", "format": "date-time" },
        "explanationReason": { "type": "string", "description": "Medical, academic, or transport justification" },
        "supportingDocStorageUrl": { "type": "string", "description": "Private Cloud Storage URI for doctor note or justification" },
        "supportingDocName": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["missed_unexplained", "explanation_submitted", "ratified", "blocked"] },
        "hrReviewNotes": { "type": "string" },
        "reviewedByAdminId": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "applicationId", "candidateId", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Physical venue attendance validation record verified via QR or fallback OTP.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Attendance record ID" },
        "interviewSlotId": { "type": "string" },
        "applicationId": { "type": "string" },
        "candidateId": { "type": "string" },
        "hiringDriveId": { "type": "string" },
        "verifiedMethod": { "type": "string", "enum": ["qr_hmac", "otp_passcode", "admin_override"] },
        "verifiedByUserId": { "type": "string", "description": "Coordinator or admin UID" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "roomOrPanel": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "interviewSlotId", "applicationId", "candidateId", "verifiedMethod", "verifiedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit log of recruitment state changes, administrative actions, and security alerts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry ID" },
        "timestamp": { "type": "string", "format": "date-time" },
        "action": { "type": "string", "description": "Action type (e.g. slot_allocated, standby_promoted, attendance_verified)" },
        "actorId": { "type": "string", "description": "UID of the initiating user or system" },
        "actorRole": { "type": "string", "description": "Role of the initiating user" },
        "targetId": { "type": "string", "description": "Subject entity ID" },
        "details": { "type": "string", "description": "Contextual description of event" },
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["id", "timestamp", "action", "actorId", "actorRole", "targetId", "details"]
    },
    "InternalHRNote": {
      "title": "InternalHRNote",
      "description": "Confidential HR and interviewer evaluations strictly invisible to candidates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Note ID" },
        "candidateId": { "type": "string", "description": "Target candidate User UID" },
        "authorId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "authorRole": { "type": "string", "description": "Author staff role" },
        "note": { "type": "string", "description": "Assessment commentary or internal remarks" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "candidateId", "authorId", "authorName", "note"]
    },
    "InterviewerPanel": {
      "title": "InterviewerPanel",
      "description": "Assigned evaluation panel and interviewer roster for campus hiring drives.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Panel ID" },
        "name": { "type": "string", "description": "Interviewer or lead evaluator name" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "description": "Technical panel role or designation" },
        "department": { "type": "string", "description": "Engineering or QA department" },
        "skills": { "type": "array", "description": "Core technical competencies assessed" },
        "assignedPanel": { "type": "string", "description": "Designated room or panel title" },
        "location": { "type": "string", "description": "Assigned campus city" },
        "activeInterviewsCount": { "type": "number", "description": "Active interviews handled" },
        "availableDays": { "type": "array", "description": "Assigned availability calendar" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "assignedPanel", "location"]
    },
    "SlotRecoveryIncident": {
      "title": "SlotRecoveryIncident",
      "description": "Self-healing incident tracking vacated slots and standby candidate match metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Incident ID" },
        "vacantSlotId": { "type": "string" },
        "hiringDriveId": { "type": "string" },
        "role": { "type": "string" },
        "venue": { "type": "string" },
        "slotDate": { "type": "string" },
        "slotTime": { "type": "string" },
        "vacatedByCandidateId": { "type": "string" },
        "vacatedByCandidateName": { "type": "string" },
        "vacatedReason": { "type": "string", "enum": ["no_show", "candidate_cancelled", "rescheduled"] },
        "detectedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["vacant", "invitations_dispatched", "recovered", "unfilled"] },
        "matchedStandbyCandidateId": { "type": "string" },
        "matchedStandbyCandidateName": { "type": "string" },
        "matchScore": { "type": "number", "description": "Algorithmic match score (0-100)" },
        "matchScoreBreakdown": { "type": "object", "description": "Score components: skills, location, academic, availability" },
        "candidateResponseDeadline": { "type": "string", "format": "date-time" },
        "recoveredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "vacantSlotId", "hiringDriveId", "vacatedReason", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Candidate notification dispatch record for schedules, status shifts, and action alerts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "candidateId": { "type": "string", "description": "Target candidate User UID" },
        "type": { "type": "string", "description": "Alert classification" },
        "title": { "type": "string", "description": "Alert title" },
        "message": { "type": "string", "description": "Alert body text" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean", "description": "Read flag" },
        "deliveryChannel": { "type": "string", "enum": ["in_app", "fcm", "sms", "email"] },
        "isSimulatedExternal": { "type": "boolean" },
        "actionRoute": { "type": "object", "description": "Deep link action routing target" }
      },
      "required": ["id", "candidateId", "type", "title", "message", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated user accounts and RBAC role profiles."
    },
    "/candidate_profiles/{candidateId}": {
      "schema": { "$ref": "#/entities/CandidateProfile" },
      "description": "Candidate academic credentials, verified skills, and resume metadata."
    },
    "/hiring_drives/{driveId}": {
      "schema": { "$ref": "#/entities/HiringDrive" },
      "description": "Active and scheduled corporate recruitment drives with capacity limits."
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Candidate drive applications tracking stage progression and scheduling state."
    },
    "/interview_slots/{slotId}": {
      "schema": { "$ref": "#/entities/InterviewSlot" },
      "description": "Physical interview panel slots guarded by concurrency mutexes."
    },
    "/waitlists/{waitlistId}": {
      "schema": { "$ref": "#/entities/WaitlistEntry" },
      "description": "Drive capacity overflow FIFO queues for candidate waitlist management."
    },
    "/standby_invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/StandbyInvitation" },
      "description": "Proactive standby pool candidate invitations and replacement slot claims."
    },
    "/absence_records/{recordId}": {
      "schema": { "$ref": "#/entities/AbsenceRecord" },
      "description": "Missed interview records with candidate justification and HR ratification."
    },
    "/attendance_records/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "QR HMAC and OTP verified venue check-in records."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security and administrative action audit trails."
    },
    "/internal_hr_notes/{noteId}": {
      "schema": { "$ref": "#/entities/InternalHRNote" },
      "description": "Restricted HR and interviewer evaluations invisible to candidates."
    },
    "/interviewer_panels/{panelId}": {
      "schema": { "$ref": "#/entities/InterviewerPanel" },
      "description": "Interviewer roster, panel assignments, and load tracking."
    },
    "/slot_recovery_incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/SlotRecoveryIncident" },
      "description": "Automated self-healing slot recovery incidents and match score breakdowns."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Candidate in-app notifications and scheduled status updates."
    }
  }
}

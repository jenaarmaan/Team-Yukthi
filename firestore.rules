rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL HELPERS & PREDICATES
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Direct Bootstrapped Admin from runtime environment
    function isBootstrappedAdmin() {
      return isSignedIn() &&
        (request.auth.token.email in ['jena.sushmita786@gmail.com', 'armaan.jena08@gmail.com', 'armaan.sj04@gmail.com']) &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'hr_admin', 'recruitment_manager']
      );
    }

    function isInterviewerOrCoordinator() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['interview_coordinator', 'interviewer']
      );
    }

    // Health Check Test Collection (Restricted to genuine diagnostic connectivity checks)
    match /_health_check/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isInterviewerOrCoordinator());
      allow list: if isAdmin();
      // Users can only be created or modified with strict validation; roles cannot be self-escalated
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().keys().hasAll(['uid', 'email', 'role', 'displayName', 'isActive']) &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'candidate' &&
        incoming().isActive == true;
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'avatarInitials', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. CANDIDATE PROFILES
    match /candidate_profiles/{candidateId} {
      allow get: if isValidId(candidateId) && (isOwner(candidateId) || isInterviewerOrCoordinator());
      allow list: if isInterviewerOrCoordinator() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create: if isValidId(candidateId) && isOwner(candidateId) &&
        incoming().id == request.auth.uid &&
        incoming().keys().hasAll(['id', 'fullName', 'email', 'candidateType', 'currentLocation']) &&
        incoming().verificationStatus == 'pending';
      allow update: if isValidId(candidateId) && (
        isAdmin() ||
        (isOwner(candidateId) && incoming().diff(existing()).affectedKeys().hasOnly(['preferredLocations', 'education', 'workExperience', 'skills', 'profileCompletionPercentage', 'resumeStorageUrl', 'resumeOriginalName', 'updatedAt']))
      );
      allow delete: if isValidId(candidateId) && isAdmin();
    }

    // 3. HIRING DRIVES (Catalog is readable by candidates and staff)
    match /hiring_drives/{driveId} {
      allow get: if isValidId(driveId);
      allow list: if true; // Public / applicant visibility for open drives
      allow create, update, delete: if isValidId(driveId) && isAdmin();
    }

    // 4. APPLICATIONS
    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && (
        isInterviewerOrCoordinator() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isInterviewerOrCoordinator() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create: if isValidId(applicationId) && isSignedIn() &&
        incoming().candidateId == request.auth.uid &&
        incoming().status in ['registered', 'shortlisted', 'waitlisted'] &&
        exists(/databases/$(database)/documents/hiring_drives/$(incoming().hiringDriveId));
      allow update: if isValidId(applicationId) && (
        isAdmin() ||
        (isSignedIn() && existing().candidateId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['appliedLocation', 'updatedAt']))
      );
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // 5. INTERVIEW SLOTS
    match /interview_slots/{slotId} {
      allow get: if isValidId(slotId) && (
        isInterviewerOrCoordinator() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isInterviewerOrCoordinator() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create, update, delete: if isValidId(slotId) && isInterviewerOrCoordinator();
    }

    // 6. WAITLISTS
    match /waitlists/{waitlistId} {
      allow get: if isValidId(waitlistId) && (
        isAdmin() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create, update, delete: if isValidId(waitlistId) && isAdmin();
    }

    // 7. STANDBY INVITATIONS
    match /standby_invitations/{invitationId} {
      allow get: if isValidId(invitationId) && (
        isAdmin() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create: if isValidId(invitationId) && isAdmin();
      allow update: if isValidId(invitationId) && (
        isAdmin() ||
        (isSignedIn() && existing().candidateId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['invitationStatus', 'respondedAt', 'replacementSlot']))
      );
      allow delete: if isValidId(invitationId) && isAdmin();
    }

    // 8. ABSENCE RECORDS
    match /absence_records/{recordId} {
      allow get: if isValidId(recordId) && (
        isAdmin() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create: if isValidId(recordId) && (
        isAdmin() ||
        (isSignedIn() && incoming().candidateId == request.auth.uid)
      );
      allow update: if isValidId(recordId) && (
        isAdmin() ||
        (isSignedIn() && existing().candidateId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['explanationReason', 'supportingDocStorageUrl', 'supportingDocName', 'submittedAt']))
      );
      allow delete: if isValidId(recordId) && isAdmin();
    }

    // 9. ATTENDANCE RECORDS
    match /attendance_records/{attendanceId} {
      allow get: if isValidId(attendanceId) && (
        isInterviewerOrCoordinator() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isInterviewerOrCoordinator() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create, update, delete: if isValidId(attendanceId) && isInterviewerOrCoordinator();
    }

    // 10. AUDIT LOGS (Immutable security ledger)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isSignedIn();
      allow update, delete: if false; // Strictly immutable
    }

    // 11. INTERNAL HR NOTES (Privileged HR comments strictly inaccessible to candidates)
    match /internal_hr_notes/{noteId} {
      allow read, write: if isValidId(noteId) && isAdmin();
    }

    // 12. INTERVIEWER PANELS
    match /interviewer_panels/{panelId} {
      allow get: if isValidId(panelId) && isInterviewerOrCoordinator();
      allow list: if isInterviewerOrCoordinator();
      allow create, update, delete: if isValidId(panelId) && isAdmin();
    }

    // 13. SLOT RECOVERY INCIDENTS
    match /slot_recovery_incidents/{incidentId} {
      allow get, list: if isValidId(incidentId) && isAdmin();
      allow create, update, delete: if isValidId(incidentId) && isAdmin();
    }

    // 14. NOTIFICATIONS
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isAdmin() || (isSignedIn() && resource.data.candidateId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.candidateId == request.auth.uid
      );
      allow create: if isValidId(notificationId) && isAdmin();
      allow update: if isValidId(notificationId) && (
        isAdmin() ||
        (isSignedIn() && existing().candidateId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']))
      );
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    // 15. DISTRIBUTED LOCKS & CONCURRENCY SAFEGUARDS (Backend transactional mutexes)
    match /distributed_locks/{lockId} {
      allow read, write: if isValidId(lockId);
    }

    // 16. IDEMPOTENCY KEYS (Duplicate submission prevention)
    match /idempotency_keys/{keyId} {
      allow read, write: if isValidId(keyId);
    }

    // 17. ATTENDANCE NONCES (Replay Prevention Ledger)
    match /used_attendance_nonces/{nonceId} {
      allow read, write: if isValidId(nonceId);
    }
  }
}


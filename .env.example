# NIYOJAN Unified Application Environment Configuration

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_PATH=./data/niyojan.db
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# GEMINI_API_KEY: Optional for AI Question Suggestions
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# JWT_SECRET: Secret key for signing HS256 tokens
JWT_SECRET="niyojan-enterprise-jwt-signing-secret-2026-secure"

# QR_HMAC_SECRET: Secret key for attendance pass signatures
QR_HMAC_SECRET="niyojan-venue-qr-secret-key-2026-secure-hmac"

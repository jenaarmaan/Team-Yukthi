# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Firestore and Authentication Configuration
# Auto-provisioned via ProvisionFirebase RPC and saved to firebase-applet-config.json
FIREBASE_PROJECT_ID="gen-lang-client-0148283337"
FIREBASE_DATABASE_ID="ai-studio-remixremixremixr-a44fc6b2-6b71-479c-8eb8-6312d2f0e1cd"
FIREBASE_STORAGE_BUCKET="gen-lang-client-0148283337.firebasestorage.app"

# Optional Server-Side Firebase Admin Service Account Key:
# Required for elevated server-side operations (custom claims, direct GCS V4 signing).
# In production, paste the JSON service account string or client_email/private_key into Secrets.
# Never commit private keys to source control.
# FIREBASE_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key\":\"...\"}"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gen-lang-client-0973974932.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
